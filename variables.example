# Variable reference for Railway. Paste into: service → Variables → Raw Editor, then fill in values there.
# Do NOT put real values in this file — it gets committed.
# Comments are on their own lines on purpose: some editors treat text after a value as part of the value.

# ── Required ──
DISCORD_TOKEN=
GUILD_ID=

# SQLite database path. Mount a Railway volume at /data so it survives deploys.
DB_PATH=/data/dpa.sqlite

# ── Roles (comma-separated IDs) ──
# Staff: conflicts, reviews, tickets, treaties, registry
STAFF_ROLE_IDS=
# The ONLY roles that can use /maps (list, add, remove). No staff/admin fallback.
MAP_ROLE_IDS=

# ── Channels ──
# Ticket dropdown panel (posted automatically on startup)
TICKET_CHANNEL_ID=
# Only channel /request-role works in (instructions are posted here automatically)
ROLE_REQUEST_CHANNEL_ID=
# Staff-only: requests land here with Approve / Deny
ROLE_REVIEW_CHANNEL_ID=
# Live "Active Conflicts Register" board
CONFLICT_BOARD_CHANNEL_ID=
# War start announcements (defaults to the board channel)
CONFLICT_ANNOUNCE_CHANNEL_ID=
# #dpa-maps
MAPS_CHANNEL_ID=
# Registered / removed treaties
TREATY_CHANNEL_ID=
# #registered-entities: registered / revoked criminal organizations
REGISTERED_ENTITIES_CHANNEL_ID=
# Audit log + ticket transcripts
LOG_CHANNEL_ID=
# Staff pings for inactive conflicts and expired ceasefires (defaults to LOG_CHANNEL_ID)
STAFF_PING_CHANNEL_ID=

# ── Categories ──
TICKET_CATEGORY_ID=
CONFLICT_CATEGORY_ID=
# Comma-separated; when one hits Discord's 50-channel cap the next is used
ARCHIVE_CATEGORY_IDS=

# ── Behaviour ──
MAX_REPS_PER_NATION=2
DELETE_CONFLICT_ROLE_ON_END=true
# Days without messages before staff are pinged about a conflict (0 = off)
INACTIVITY_DAYS=3
# Optional small icon for embed footers (an image you have rights to use)
EMBED_ICON_URL=
